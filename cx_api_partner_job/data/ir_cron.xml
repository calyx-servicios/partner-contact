<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_forward_queue_job" model="ir.cron">
            <field name="name">Process Forward Queue</field>
            <field name="model_id" ref="base.model_ir_actions_server"/>
            <field name="state">code</field>
            <field name="code">model.env['cx_api_partner_job.forward_queue_job'].run_forward_queue()</field>
            <field name="interval_number" eval="5"/>
            <field name="interval_type">minutes</field>
            <field name="numbercall" eval="-1"/>
            <field name="doall" eval="False"/>
        </record>
    </data>
</odoo>
