<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action for Forward Queue -->
        <record id="cx_api_partner_forward_queue_action" model="ir.actions.act_window">
            <field name="name">Forward Queue</field>
            <field name="res_model">cx_api_partner_forward_queue.forward_queue</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{"search_default_pending": 1, "search_default_retry_pending": 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No pending forwards found.
                </p>
                <p>
                    Pending API forwards will appear here.
                </p>
            </field>
        </record>

        <!-- Tree View -->
        <record id="cx_api_partner_forward_queue_tree" model="ir.ui.view">
            <field name="name">Forward Queue (Tree)</field>
            <field name="model">cx_api_partner_forward_queue.forward_queue</field>
            <field name="arch" type="xml">
                <tree string="Forward Queue" decoration-warning="status == 'failed'" decoration-success="status == 'success'" decoration-info="status == 'retry_pending'">
                    <field name="reference"/>
                    <field name="company_id"/>
                    <field name="url"/>
                    <field name="method"/>
                    <field name="status"/>
                    <field name="attempts"/>
                    <field name="created_at"/>
                </tree>
            </field>
        </record>

        <!-- Form View -->
        <record id="cx_api_partner_forward_queue_form" model="ir.ui.view">
            <field name="name">Forward Queue (Form)</field>
            <field name="model">cx_api_partner_forward_queue.forward_queue</field>
            <field name="arch" type="xml">
                <form string="Forward Queue Entry">
                    <header>
                        <field name="status" widget="statusbar" options="{'clickable': True}"/>
                    </header>
                    <group>
                        <group>
                            <field name="reference" readonly="1"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="attempts" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="url" readonly="1"/>
                            <field name="method" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Headers">
                            <field name="headers" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Response">
                            <group>
                                <field name="response_code" readonly="1"/>
                                <field name="error_message" readonly="1"/>
                            </group>
                            <field name="response_payload" readonly="1" nolabel="1" widget="ace" options="{'mode': 'json'}"/>
                        </page>
                        <page string="Timestamps">
                            <group>
                                <field name="created_at" readonly="1"/>
                                <field name="updated_at" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </form>
            </field>
        </record>

        <!-- Search View -->
        <record id="cx_api_partner_forward_queue_search" model="ir.ui.view">
            <field name="name">Forward Queue (Search)</field>
            <field name="model">cx_api_partner_forward_queue.forward_queue</field>
            <field name="arch" type="xml">
                <search string="Forward Queue">
                    <field name="reference"/>
                    <field name="company_id"/>
                    <field name="url"/>
                    <separator/>
                    <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                    <filter string="Success" name="success" domain="[('status', '=', 'success')]"/>
                    <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                    <filter string="Retry Pending" name="retry_pending" domain="[('status', '=', 'retry_pending')]"/>
                    <separator/>
                    <filter string="Created Today" name="today" domain="[('created_at', '>=', context_today().strftime('%Y-%m-%d 00:00:00')), ('created_at', '&lt;=', context_today().strftime('%Y-%m-%d 23:59:59'))]"/>
                    <separator/>
                    <group expand="1" string="Group By">
                        <filter string="Status" name="group_by_status" context="{'group_by': 'status'}"/>
                        <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}"/>
                        <filter string="Method" name="group_by_method" context="{'group_by': 'method'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
