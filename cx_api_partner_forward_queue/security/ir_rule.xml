<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Security rule: Only system admins can read forward_queue records -->
        <record id="cx_api_partner_forward_queue_admin_rule" model="ir.rule">
            <field name="name">Forward Queue - Admin Only</field>
            <field name="model_id" ref="cx_api_partner_forward_queue.model_cx_api_partner_forward_queue_forward_queue"/>
            <field name="groups" eval="[(4, ref('base.group_system'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
    </data>
</odoo>
