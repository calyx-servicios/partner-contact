<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_cx_api_partner" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cx.api.partner</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Contact Forwarding" string="Contact Forwarding" data-key="cx_api_partner">
                    <h2>
                        Contact Forwarding <field name="contact_forward_enabled" widget="boolean_toggle" onchange="_check_forward_queue_module" groups="cx_api_partner.group_api_partner_manager"/>
                    </h2>
                    <div class="row mt16 o_settings_container" id="cx_api_partner_config">
                        <div class="col-12 col-lg-12 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="contact_forward_enabled"/>
                                <div class="content-group">
                                    <div class="mt16">
                                        <p class="text-muted">Enable contact forwarding for all companies. When enabled, contact forwarding will work the same way for all companies in the system.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
    <record id="action_cx_api_partner_config_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_id" ref="view_res_config_settings_cx_api_partner"/>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'cx_api_partner'}</field>
    </record>
</odoo>
